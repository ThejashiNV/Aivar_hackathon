# Local development (SQLite, no config needed)
# DATABASE_URL=sqlite:///./guardian.db

# Production PostgreSQL (set these instead of DATABASE_URL)
# DB_HOST=your-db-host.pooler.supabase.com
# DB_PORT=5432
# DB_USER=postgres.your_project_ref
# DB_PASSWORD=your_password_here
# DB_NAME=postgres
# DB_SSLMODE=prefer  (use "require" for remote DBs, "disable" for local without SSL)

# Google Gemini API key (optional — app works without it)
GEMINI_API_KEY=

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
